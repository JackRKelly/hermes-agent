{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action_item_kinds/design_decision.v1.schema.json",
  "title": "design_decision v1 payload",
  "description": "Agent fields: question, options, rec_reason. option_set_hash is computed by the tool.",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "options", "rec_reason", "option_set_hash"],
  "properties": {
    "question": {"type": "string", "maxLength": 300, "x-text": "text-line"},
    "options": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/option"}},
    "rec_reason": {"type": "string", "maxLength": 500, "x-text": "text"},
    "option_set_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "effect", "pros", "cons", "recommended"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"},
        "label": {"type": "string", "maxLength": 80, "x-text": "text-line"},
        "effect": {"type": "string", "maxLength": 280, "x-text": "text"},
        "pros": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 200, "x-text": "text"}},
        "cons": {"type": "array", "maxItems": 5, "items": {"type": "string", "maxLength": 200, "x-text": "text"}},
        "recommended": {"type": "boolean"}
      }
    }
  }
}
