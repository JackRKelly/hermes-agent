{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action_item_kinds/other.v1.schema.json",
  "title": "other v1 payload",
  "description": "Agent fields: title, body (the only markdown-subset field of any kind), links. body_hash is computed by the tool.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "body", "links", "body_hash"],
  "properties": {
    "title": {"type": "string", "maxLength": 140, "x-text": "text-line"},
    "body": {"type": "string", "maxLength": 4000, "x-text": "markdown"},
    "links": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/link"}},
    "body_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {"type": "string", "maxLength": 40, "x-text": "line"},
        "url": {"type": "string", "x-link": true}
      }
    }
  }
}
