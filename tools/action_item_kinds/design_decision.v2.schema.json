{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action_item_kinds/design_decision.v2.schema.json",
  "title": "design_decision v2 payload",
  "description": "Agent fields: questions, rec_reason. Jack answers every question (2-4 options each, the recommended one shown first, plus Other when allow_other). option_set_hash is computed by the tool over all questions. Limits match JackRKelly/assistant docs/action-items-card-guide.md (tools/action_item_kinds/readability.py).",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions", "option_set_hash"],
  "properties": {
    "questions": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/question"}},
    "rec_reason": {"type": "string", "maxLength": 240, "x-text": "text"},
    "option_set_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "question", "options", "allow_other"],
      "properties": {
        "key": {"type": "string", "pattern": "^q[1-5]$"},
        "question": {"type": "string", "maxLength": 120, "x-text": "text-line"},
        "options": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/option"}},
        "allow_other": {"type": "boolean"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "recommended"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"},
        "label": {"type": "string", "maxLength": 40, "x-text": "text-line"},
        "effect": {"type": "string", "maxLength": 120, "x-text": "text"},
        "recommended": {"type": "boolean"}
      }
    }
  }
}
